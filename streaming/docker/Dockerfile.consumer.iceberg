
FROM eclipse-temurin:17-jdk AS builder

WORKDIR /app

COPY target/scala-2.12/nexus-streaming-assembly.jar app.jar

FROM apache/spark:3.5.9

USER root

WORKDIR /app

COPY --from=builder /app/app.jar /app/app.jar

RUN mkdir -p /data/checkpoint /data/iceberg/warehouse && \
    chown -R 185:0 /app /data

USER 185

ENTRYPOINT ["/opt/spark/bin/spark-submit"]
